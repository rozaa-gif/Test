# Azure Bot Service registration (leave blank to run locally against the
# Bot Framework Emulator with auth disabled)
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppType=MultiTenant
MicrosoftAppTenantId=

PORT=3978

# Folder of files the bot summarizes by default, in addition to anything
# attached in the conversation.
KNOWLEDGE_FOLDER=sample_files

# Where per-conversation attachments and generated reports are staged.
WORK_DIR=output/_work
